            {
              "id": "strix-coverage/privilege-escalation-mass-assignment-admin-authorization",
              "name": "Privilege escalation / mass assignment / admin authorization",
              "shortDescription": {
                "text": "Coverage: Privilege escalation / mass assignment / admin authorization"
